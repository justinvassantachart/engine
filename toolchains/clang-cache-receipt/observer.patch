index 000000000..a726bd1f5
--- /dev/null
+++ b/clang/lib/Frontend/WebIDECacheReceipt.cpp
@@ -0,0 +1,325 @@
+//===- WebIDECacheReceipt.cpp - Bounded observation only --------------------===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "clang/Frontend/WebIDECacheReceipt.h"
+#include "WebIDECacheReceiptPCH.h"
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/DeclCXX.h"
+#include "clang/AST/DeclTemplate.h"
+#include "clang/AST/Stmt.h"
+#include "clang/AST/StmtCXX.h"
+#include "clang/Basic/SourceManager.h"
+#include "clang/Frontend/CompilerInstance.h"
+#include "clang/Frontend/Utils.h"
+#include "clang/Lex/PPCallbacks.h"
+#include "clang/Lex/Preprocessor.h"
+#include "clang/Lex/PreprocessorLexer.h"
+#include "clang/Lex/PreprocessorOptions.h"
+#include "clang/Serialization/ASTReader.h"
+#include "clang/Serialization/ModuleFile.h"
+#include "clang/Serialization/ModuleManager.h"
+#include "llvm/IR/InlineAsm.h"
+#include "llvm/IR/Instructions.h"
+#include "llvm/IR/Module.h"
+#include "llvm/Support/ConvertUTF.h"
+#include <cstdlib>
+#include <cstring>
+#include <new>
+
+using namespace clang;
+using llvm::StringRef;
+namespace {
+constexpr unsigned MaxString = 4096, MaxDeps = 16384, MaxProbes = 8192;
+constexpr unsigned ArenaBytes = 1024 * 1024, JsonBytes = 1024 * 1024;
+struct Ref { unsigned Offset = 0, Length = 0; };
+struct Probe { Ref Name, Includer, Found; bool Angled = false, HasFound = false; };
+class Receipt;
+class ReceiptCallbacks final : public PPCallbacks {
+  Receipt &Owner;
+  Preprocessor &PP;
+public:
+  ReceiptCallbacks(Receipt &O, Preprocessor &P) noexcept : Owner(O), PP(P) {}
+  static void *operator new(size_t N, const std::nothrow_t &) noexcept { return std::malloc(N); }
+  static void operator delete(void *P) noexcept { std::free(P); }
+  static void operator delete(void *P, const std::nothrow_t &) noexcept { std::free(P); }
+  void LexedFileChanged(FileID, LexedFileChangeReason, SrcMgr::CharacteristicKind,
+                        FileID, SourceLocation) override;
+  void FileSkipped(const FileEntryRef &, const Token &, SrcMgr::CharacteristicKind) override;
+  void HasInclude(SourceLocation, StringRef, bool, OptionalFileEntryRef,
+                  SrcMgr::CharacteristicKind) override;
+  void BuiltinMacroExpanded(StringRef) override;
+  void EmbedDirective(SourceLocation, StringRef, bool, OptionalFileEntryRef,
+                      const LexEmbedParametersResult &) override;
+  void HasEmbed(SourceLocation, StringRef, bool, OptionalFileEntryRef) override;
+  void InclusionDirective(SourceLocation, const Token &, StringRef, bool,
+                           CharSourceRange, OptionalFileEntryRef, StringRef,
+                           StringRef, const clang::Module *, bool,
+                           SrcMgr::CharacteristicKind) override;
+};
+
+class Receipt final : public DependencyCollector {
+  CompilerInstance &CI;
+  ASTReader *Reader = nullptr;
+  char Arena[ArenaBytes], Json[JsonBytes];
+  unsigned Used = 0, JsonUsed = 0;
+  Ref Source, Dependencies[MaxDeps], PCHs[16];
+  unsigned DepCount = 0, PCHCount = 0, Slots[MaxDeps * 2] = {};
+  Probe Probes[MaxProbes];
+  unsigned ProbeCount = 0;
+  const char *Unsupported = nullptr;
+  bool Date = false, Time = false, Timestamp = false, Counter = false;
+  bool Observed = false, Emitted = false, PCHIndependent = true, JsonOK = true;
+  // Traversal uses fixed storage, skips lazy/imported declarations and never
+  // invokes an allocating RecursiveASTVisitor or external AST source.
+  struct Node { const void *Ptr; bool IsDecl; };
+  Node Nodes[65536];
+  unsigned NodeCount = 0;
+  StringRef text(Ref R) const noexcept { return StringRef(Arena + R.Offset, R.Length); }
+  bool store(StringRef S, Ref &R) noexcept {
+    if (S.empty() || S.size() > MaxString || S.contains('\0') || S.size() > ArenaBytes - Used) {
+      unsupported("metadata-limit"); return false;
+    }
+    for (unsigned char C : S.bytes())
+      if (C < 32 || C == 127) { unsupported("unsupported-string"); return false; }
+    const auto *U = reinterpret_cast<const llvm::UTF8 *>(S.data());
+    if (!llvm::isLegalUTF8String(&U, U + S.size())) { unsupported("invalid-utf8"); return false; }
+    R = {Used, static_cast<unsigned>(S.size())};
+    std::memcpy(Arena + Used, S.data(), S.size()); Used += S.size(); return true;
+  }
+  bool path(StringRef S, char (&Out)[MaxString + 1], unsigned &N) noexcept {
+    if (S.empty() || S.size() > MaxString || S.contains('\0') || S.contains('\\')) {
+      unsupported("unsupported-path"); return false;
+    }
+    for (unsigned char C : S.bytes())
+      if (C < 32 || C == 127) { unsupported("unsupported-path"); return false; }
+    N = 1; Out[0] = '/';
+    while (!S.empty()) {
+      auto Pair = S.split('/'); auto Part = Pair.first; S = Pair.second;
+      if (Part.empty() || Part == ".") continue;
+      if (Part == "..") {
+        if (N == 1) { unsupported("path-outside-root"); return false; }
+        while (N > 1 && Out[N - 1] != '/') --N;
+        if (N > 1) --N;
+        continue;
+      }
+      if (Part.front() == '<' || Part.size() + N + (N > 1 ? 1 : 0) > MaxString) {
+        unsupported("unsupported-path"); return false;
+      }
+      if (N > 1) Out[N++] = '/';
+      std::memcpy(Out + N, Part.data(), Part.size()); N += Part.size();
+    }
+    if (N == 1) { unsupported("unsupported-path"); return false; }
+    Out[N] = 0; return true;
+  }
+  bool storePath(StringRef S, Ref &R) noexcept {
+    char B[MaxString + 1]; unsigned N;
+    return path(S, B, N) && store(StringRef(B, N), R);
+  }
+  void put(StringRef S) noexcept {
+    if (!JsonOK || S.size() > JsonBytes - JsonUsed) { JsonOK = false; return; }
+    std::memcpy(Json + JsonUsed, S.data(), S.size()); JsonUsed += S.size();
+  }
+  void quoted(StringRef S) noexcept {
+    static constexpr char Hex[] = "0123456789abcdef";
+    put("\"");
+    for (unsigned char C : S.bytes()) {
+      if (C == '"') put("\\\"");
+      else if (C == '\\') put("\\\\");
+      else if (C < 32) { char E[] = {'\\', 'u', '0', '0', Hex[C >> 4], Hex[C & 15]}; put(StringRef(E, 6)); }
+      else { char V = C; put(StringRef(&V, 1)); }
+    }
+    put("\"");
+  }
+  void refs(const Ref *Rs, unsigned Count) noexcept {
+    put("["); for (unsigned I = 0; I < Count; ++I) { if (I) put(","); quoted(text(Rs[I])); } put("]");
+  }
+  void push(const Decl *D) noexcept {
+    if (!D || D->isFromASTFile()) return;
+    if (NodeCount == 65536) { unsupported("ast-observation-limit"); return; }
+    Nodes[NodeCount++] = {D, true};
+  }
+  void push(const Stmt *S) noexcept {
+    if (!S) return;
+    if (NodeCount == 65536) { unsupported("ast-observation-limit"); return; }
+    Nodes[NodeCount++] = {S, false};
+  }
+  void inspectAST(ASTContext &C) noexcept {
+    push(C.getTranslationUnitDecl()); unsigned Visited = 0;
+    while (NodeCount && !Unsupported) {
+      if (++Visited > 1000000) { unsupported("ast-observation-limit"); break; }
+      Node N = Nodes[--NodeCount];
+      if (N.IsDecl) {
+        const auto *D = static_cast<const Decl *>(N.Ptr);
+        if (const auto *A = llvm::dyn_cast<FileScopeAsmDecl>(D)) {
+          if (!A->getAsmString()->getString().empty()) unsupported("assembly");
+        }
+        if (const auto *F = llvm::dyn_cast<FunctionDecl>(D)) {
+          // The body of this already source-parsed declaration only.
+          push(F->getBodyIfAlreadyLoaded());
+        }
+        if (const auto *V = llvm::dyn_cast<VarDecl>(D)) push(V->getInitIfAlreadyLoaded());
+        if (const auto *T = llvm::dyn_cast<TemplateDecl>(D)) push(T->getTemplatedDecl());
+        if (const auto *DC = llvm::dyn_cast<DeclContext>(D))
+          for (const Decl *Child : DC->noload_decls()) push(Child);
+      } else {
+        const auto *S = static_cast<const Stmt *>(N.Ptr);
+        if (const auto *A = llvm::dyn_cast<GCCAsmStmt>(S)) {
+          if (!A->getAsmString()->getString().empty()) unsupported("assembly");
+        } else if (const auto *A = llvm::dyn_cast<MSAsmStmt>(S)) {
+          if (!A->getAsmString().empty()) unsupported("assembly");
+        }
+        if (const auto *DS = llvm::dyn_cast<DeclStmt>(S))
+          for (const Decl *D : DS->decls()) push(D);
+        for (const Stmt *Child : S->children()) push(Child);
+      }
+    }
+  }
+  static bool pchSink(void *Self, StringRef Name) noexcept {
+    return static_cast<Receipt *>(Self)->dependency(Name);
+  }
+  void inspectPCH() noexcept {
+    if (!Reader) {
+      if (!CI.getPreprocessorOpts().ImplicitPCHInclude.empty()) unsupported("pch-not-observed");
+      return;
+    }
+    for (const auto &M : Reader->getModuleManager()) {
+      if (M.Kind != serialization::MK_PCH || !M.Imports.empty() ||
+          !M.ImportedBy.empty() || !M.TransitiveImports.empty()) {
+        unsupported("imported-or-chained-pch"); continue;
+      }
+      if (PCHCount == 16) { unsupported("pch-count-limit"); return; }
+      Ref R;
+      if (!storePath(M.FileName, R) || !dependency(M.FileName)) continue;
+      PCHs[PCHCount++] = R;
+      auto Proof = webide::inspectPCHInputs(M, this, pchSink);
+      PCHIndependent &= Proof.metadataIndependent;
+      if (!Proof.complete) unsupported(Proof.unsupported ? Proof.unsupported : "pch-incomplete");
+    }
+    if (PCHCount != (CI.getPreprocessorOpts().ImplicitPCHInclude.empty() ? 0u : 1u))
+      unsupported("pch-set-mismatch");
+  }
+public:
+  explicit Receipt(CompilerInstance &Instance) noexcept : CI(Instance) {
+    const auto &Inputs = CI.getFrontendOpts().Inputs;
+    if (Inputs.size() != 1 || !Inputs.front().isFile()) { unsupported("input-kind"); return; }
+    if (!storePath(Inputs.front().getFile(), Source)) return;
+    dependency(Inputs.front().getFile());
+    if (CI.getLangOpts().Modules || !CI.getPreprocessorOpts().ChainedIncludes.empty())
+      unsupported("modules-or-chained-pch");
+  }
+  static void *operator new(size_t N, const std::nothrow_t &) noexcept { return std::malloc(N); }
+  static void operator delete(void *P) noexcept { std::free(P); }
+  static void operator delete(void *P, const std::nothrow_t &) noexcept { std::free(P); }
+  void unsupported(const char *Why) noexcept { if (!Unsupported) Unsupported = Why; }
+  bool dependency(StringRef S) noexcept {
+    char B[MaxString + 1]; unsigned N;
+    if (!path(S, B, N)) return false;
+    StringRef Name(B, N); uint32_t Hash = 2166136261u;
+    for (unsigned char C : Name.bytes()) Hash = (Hash ^ C) * 16777619u;
+    unsigned Slot = Hash & (MaxDeps * 2 - 1);
+    for (unsigned I = 0; I < MaxDeps * 2; ++I, Slot = (Slot + 1) & (MaxDeps * 2 - 1)) {
+      if (Slots[Slot]) { if (text(Dependencies[Slots[Slot] - 1]) == Name) return true; continue; }
+      if (DepCount == MaxDeps) { unsupported("dependency-limit"); return false; }
+      if (!store(Name, Dependencies[DepCount])) return false;
+      Slots[Slot] = ++DepCount; return true;
+    }
+    unsupported("dependency-limit"); return false;
+  }
+  void probe(Preprocessor &PP, StringRef Name, bool Angled, OptionalFileEntryRef Found) noexcept {
+    if (ProbeCount == MaxProbes) { unsupported("probe-limit"); return; }
+    auto *Lexer = PP.getCurrentFileLexer();
+    if (!Lexer) { unsupported("probe-includer"); return; }
+    auto File = PP.getSourceManager().getFileEntryRefForID(Lexer->getFileID());
+    if (!File) { unsupported("probe-includer"); return; }
+    Probe P;
+    if (!store(Name, P.Name) || !storePath(File->getName(), P.Includer) || !dependency(File->getName())) return;
+    P.Angled = Angled; P.HasFound = bool(Found);
+    if (Found && (!storePath(Found->getName(), P.Found) || !dependency(Found->getName()))) return;
+    Probes[ProbeCount++] = P;
+  }
+  void builtin(StringRef Name) noexcept {
+    if (Name == "__DATE__") Date = true;
+    else if (Name == "__TIME__") Time = true;
+    else if (Name == "__TIMESTAMP__") Timestamp = true;
+    else if (Name == "__COUNTER__") Counter = true;
+    else if (Name == "__has_embed") unsupported("embed");
+  }
+  void attachToPreprocessor(Preprocessor &PP) override {
+    std::unique_ptr<PPCallbacks> C(new (std::nothrow) ReceiptCallbacks(*this, PP));
+    if (!PP.tryAddPPCallbacks(std::move(C))) unsupported("observer-allocation");
+  }
+  void attachToASTReader(ASTReader &R) override {
+    if (Reader && Reader != &R) unsupported("multiple-ast-readers");
+    Reader = &R;
+    // Deliberately do not attach stock all-input visitation: otherwise unused
+    // malformed PCH input records must not change ordinary compilation.
+  }
+  void observe(ASTContext &C, llvm::Module *M) noexcept {
+    if (Observed) { unsupported("multiple-translation-units"); return; }
+    Observed = true; inspectPCH();
+    if (!M) { unsupported("missing-ir"); return; }
+    if (!M->getModuleInlineAsm().empty()) unsupported("assembly");
+    unsigned IRVisited = 0;
+    for (const auto &F : *M) for (const auto &B : F) for (const auto &I : B) {
+      if (++IRVisited > 1000000) { unsupported("ir-observation-limit"); return; }
+      if (const auto *Call = llvm::dyn_cast<llvm::CallBase>(&I))
+        if (const auto *A = llvm::dyn_cast<llvm::InlineAsm>(Call->getCalledOperand()))
+          if (!A->getAsmString().empty()) unsupported("assembly");
+    }
+    if (!Unsupported) inspectAST(C);
+  }
+  void finish() noexcept;
+};
+void ReceiptCallbacks::LexedFileChanged(FileID F, LexedFileChangeReason R,
+    SrcMgr::CharacteristicKind, FileID, SourceLocation) {
+  if (R != LexedFileChangeReason::EnterFile) return;
+  if (auto File = PP.getSourceManager().getFileEntryRefForID(F)) Owner.dependency(File->getName());
+}
+void ReceiptCallbacks::FileSkipped(const FileEntryRef &F, const Token &, SrcMgr::CharacteristicKind) { Owner.dependency(F.getName()); }
+void ReceiptCallbacks::HasInclude(SourceLocation, StringRef Name, bool Angled,
+    OptionalFileEntryRef F, SrcMgr::CharacteristicKind) { Owner.probe(PP, Name, Angled, F); }
+void ReceiptCallbacks::BuiltinMacroExpanded(StringRef Name) { Owner.builtin(Name); }
+void ReceiptCallbacks::EmbedDirective(SourceLocation, StringRef, bool, OptionalFileEntryRef,
+    const LexEmbedParametersResult &) { Owner.unsupported("embed"); }
+void ReceiptCallbacks::HasEmbed(SourceLocation, StringRef, bool, OptionalFileEntryRef) { Owner.unsupported("embed"); }
+void ReceiptCallbacks::InclusionDirective(SourceLocation, const Token &, StringRef,
+    bool, CharSourceRange, OptionalFileEntryRef, StringRef, StringRef,
+    const clang::Module *, bool Imported, SrcMgr::CharacteristicKind) {
+  if (Imported) Owner.unsupported("modules");
+}
+#if defined(__wasm__)
+extern "C" __attribute__((import_module("webide_compiler"), import_name("cache_receipt_v1")))
+int emitReceipt(const char *, unsigned);
+#else
+static int emitReceipt(const char *, unsigned) noexcept { return 0; }
+#endif
+void Receipt::finish() noexcept {
+  if (Emitted) return;
+  Emitted = true;
+  put("{\"schema\":1,\"capability\":\"webide-object-cache-v1\",\"completed\":");
+  put(Observed ? "true" : "false"); put(",\"source\":"); quoted(text(Source));
+  put(",\"volatileBuiltins\":["); bool Comma = false;
+  if (Date) { quoted("__DATE__"); Comma = true; }
+  if (Time) { if (Comma) put(","); quoted("__TIME__"); Comma = true; }
+  if (Timestamp) { if (Comma) put(","); quoted("__TIMESTAMP__"); }
+  put("],\"usesCounter\":"); put(Counter ? "true" : "false");
+  put(",\"unsupported\":["); if (Unsupported) quoted(Unsupported); put("]");
+  put(",\"dependencies\":"); refs(Dependencies, DepCount);
+  put(",\"includeProbes\":[");
+  for (unsigned I = 0; I < ProbeCount; ++I) {
+    const auto &P = Probes[I]; if (I) put(",");
+    put("{\"name\":"); quoted(text(P.Name)); put(",\"angled\":"); put(P.Angled ? "true" : "false");
+    put(",\"includer\":"); quoted(text(P.Includer)); put(",\"found\":");
+    if (P.HasFound) quoted(text(P.Found)); else put("null"); put("}");
+  }
+  put("],\"importedPchPaths\":"); refs(PCHs, PCHCount);
+  put(",\"pchMetadataIndependent\":"); put(PCHIndependent ? "true" : "false"); put("}");
+  if (JsonOK) (void)emitReceipt(Json, JsonUsed); // Host response cannot affect compilation.
+}
+} // namespace
+DependencyCollector *clang::createWebIDECacheReceipt(CompilerInstance &CI) noexcept { return new (std::nothrow) Receipt(CI); }
+void clang::destroyWebIDECacheReceipt(DependencyCollector *P) noexcept { delete P; }
+void clang::observeWebIDECacheReceipt(DependencyCollector *P, ASTContext &C, llvm::Module *M) noexcept {
+  if (P) static_cast<Receipt *>(P)->observe(C, M);
+}
+void clang::finishWebIDECacheReceipt(DependencyCollector *P) noexcept { if (P) static_cast<Receipt *>(P)->finish(); }
diff --git a/clang/lib/Frontend/WebIDECacheReceiptPCH.cpp b/clang/lib/Frontend/WebIDECacheReceiptPCH.cpp
new file mode 100644
index 000000000..efdcb4e93
--- /dev/null
+++ b/clang/lib/Frontend/WebIDECacheReceiptPCH.cpp
@@ -0,0 +1,66 @@
+//===- WebIDECacheReceiptPCH.cpp - Read-only PCH receipt proof ---------------===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "WebIDECacheReceiptPCH.h"
+#include "clang/Serialization/ModuleFile.h"
+#include "llvm/Bitstream/BitstreamReader.h"
+
+namespace clang::webide {
+namespace {
+bool literal(const llvm::BitCodeAbbrevOp &Op, uint64_t Value) noexcept {
+  return Op.isLiteral() && Op.getLiteralValue() == Value;
+}
+bool encoding(const llvm::BitCodeAbbrevOp &Op,
+              llvm::BitCodeAbbrevOp::Encoding Kind, uint64_t Width = 0) noexcept {
+  if (Op.isLiteral() || Op.getEncoding() != Kind)
+    return false;
+  return Kind == llvm::BitCodeAbbrevOp::Blob || Op.getEncodingData() == Width;
+}
+bool canonicalAbbreviations(const llvm::BitstreamCursor &Cursor) noexcept {
+  using Op = llvm::BitCodeAbbrevOp;
+  const auto *Input = Cursor.getAbbrevIfValid(4);
+  const auto *Hash = Cursor.getAbbrevIfValid(5);
+  if (Cursor.getAbbrevIDWidth() != 4 || !Input || !Hash ||
+      Cursor.getAbbrevIfValid(6) || Input->getNumOperandInfos() != 10 ||
+      Hash->getNumOperandInfos() != 3)
+    return false;
+  if (!literal(Input->getOperandInfo(0), 1) ||
+      !encoding(Input->getOperandInfo(1), Op::VBR, 6) ||
+      !encoding(Input->getOperandInfo(2), Op::VBR, 12) ||
+      !encoding(Input->getOperandInfo(3), Op::VBR, 32) ||
+      !encoding(Input->getOperandInfo(8), Op::VBR, 16) ||
+      !encoding(Input->getOperandInfo(9), Op::Blob))
+    return false;
+  for (unsigned I = 4; I != 8; ++I)
+    if (!encoding(Input->getOperandInfo(I), Op::Fixed, 1))
+      return false;
+  return literal(Hash->getOperandInfo(0), 2) &&
+         encoding(Hash->getOperandInfo(1), Op::Fixed, 32) &&
+         encoding(Hash->getOperandInfo(2), Op::Fixed, 32);
+}
+} // namespace
+
+PCHReceiptProof inspectPCHInputs(const serialization::ModuleFile &F,
+                                 void *Context, PCHPathSink Sink) noexcept {
+  if (F.Kind != serialization::MK_PCH || !F.DirectlyImported ||
+      F.RelocatablePCH || F.StandardCXXModule || !F.Imports.empty() ||
+      !F.TransitiveImports.empty() || !F.ImportedBy.empty() ||
+      !F.ExtensionReaders.empty() || !F.ModuleMapPath.empty() ||
+      !F.ModuleOffsetMap.empty() || !Sink)
+    return {false, false, "pch-import-topology"};
+  if (F.NumUserInputFiles > F.InputFilesLoaded.size() ||
+      F.InputFileInfosLoaded.size() != F.InputFilesLoaded.size() ||
+      !canonicalAbbreviations(F.InputFilesCursor))
+    return {false, false, "pch-input-abbreviations"};
+  struct Bridge { void *Context; PCHPathSink Sink; } B{Context, Sink};
+  auto Emit = [](void *Opaque, const char *Path, size_t Size) noexcept {
+    auto &B = *static_cast<Bridge *>(Opaque);
+    return B.Sink(B.Context, llvm::StringRef(Path, Size));
+  };
+  return pch_detail::inspect(
+      {reinterpret_cast<const unsigned char *>(F.Data.data()), F.Data.size(),
+       reinterpret_cast<const unsigned char *>(F.InputFileOffsets),
+       F.InputFileOffsetsBytes, F.InputFilesLoaded.size(), F.InputFilesOffsetBase,
+       F.InputFilesBlockEndBit, F.HasTimestamps}, &B, Emit);
+}
+} // namespace clang::webide
