+
+// A dedicated allocation path leaves existing callbacks untouched on failure.
+namespace {
+class OptionalPPCallbackChain final : public clang::PPChainedCallbacks {
+public:
+  using PPChainedCallbacks::PPChainedCallbacks;
+  static void *operator new(size_t N, const std::nothrow_t &) noexcept { return std::malloc(N); }
+  static void operator delete(void *P) noexcept { std::free(P); }
+  static void operator delete(void *P, const std::nothrow_t &) noexcept { std::free(P); }
+};
+}
+bool clang::Preprocessor::tryAddPPCallbacks(std::unique_ptr<PPCallbacks> C) noexcept {
+  if (!C) return false;
+  if (!Callbacks) { Callbacks = std::move(C); return true; }
+  // Allocation precedes constructor argument evaluation for a new-expression.
+  auto *Chain = new (std::nothrow) OptionalPPCallbackChain(std::move(C), std::move(Callbacks));
+  if (!Chain) return false;
+  Callbacks.reset(Chain);
+  return true;
+}
