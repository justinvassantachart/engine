diff --git a/clang/lib/Frontend/WebIDECacheReceiptPCHReader.h b/clang/lib/Frontend/WebIDECacheReceiptPCHReader.h
new file mode 100644
index 000000000..e3f46f818
--- /dev/null
+++ b/clang/lib/Frontend/WebIDECacheReceiptPCHReader.h
@@ -0,0 +1,179 @@
+//===- WebIDECacheReceiptPCHReader.h - Bounded PCH observation -----*- C++ -*-===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//===----------------------------------------------------------------------===//
+#ifndef LLVM_CLANG_LIB_FRONTEND_WEBIDECACHERECEIPTPCHREADER_H
+#define LLVM_CLANG_LIB_FRONTEND_WEBIDECACHERECEIPTPCHREADER_H
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+
+namespace clang::webide {
+
+struct PCHReceiptProof {
+  bool complete;
+  bool metadataIndependent;
+  const char *unsupported;
+};
+
+namespace pch_detail {
+// This reader deliberately does not use BitstreamCursor::readRecord or
+// ASTReader::getInputFileInfo. Those ordinary deserialization paths may allocate,
+// diagnose, or assert on otherwise unused malformed system-input records.
+struct InputLayout {
+  const unsigned char *Data;
+  size_t Bytes;
+  const unsigned char *Offsets;
+  size_t OffsetBytes;
+  size_t Count;
+  uint64_t BaseBit;
+  uint64_t EndBit;
+  bool HasTimestamps;
+};
+using PathSink = bool (*)(void *, const char *, size_t) noexcept;
+
+class CheckedBits {
+  const unsigned char *Data;
+  uint64_t End;
+  uint64_t Pos;
+
+public:
+  CheckedBits(const unsigned char *Data, uint64_t Start, uint64_t End) noexcept
+      : Data(Data), End(End), Pos(Start) {}
+  uint64_t position() const noexcept { return Pos; }
+  bool fixed(unsigned Width, uint64_t &Value) noexcept {
+    if (Width > 64 || Pos > End || Width > End - Pos)
+      return false;
+    Value = 0;
+    for (unsigned I = 0; I < Width; ++I, ++Pos)
+      Value |= uint64_t((Data[Pos / 8] >> (Pos % 8)) & 1) << I;
+    return true;
+  }
+  bool vbr(unsigned Width, uint64_t &Value) noexcept {
+    if (Width < 2 || Width > 32)
+      return false;
+    Value = 0;
+    unsigned Shift = 0;
+    const uint64_t More = uint64_t(1) << (Width - 1);
+    for (;;) {
+      uint64_t Word;
+      if (!fixed(Width, Word))
+        return false;
+      uint64_t Part = Word & (More - 1);
+      if (Shift >= 64 || Part > (std::numeric_limits<uint64_t>::max() >> Shift))
+        return false;
+      Value |= Part << Shift;
+      if (!(Word & More))
+        return Shift == 0 || Part != 0; // The pinned writer emits canonical VBR.
+      Shift += Width - 1;
+    }
+  }
+  bool align32() noexcept {
+    uint64_t Padding;
+    return fixed(unsigned((32 - Pos % 32) % 32), Padding) && Padding == 0;
+  }
+  bool blob(const char *&Start, size_t &Size) noexcept {
+    uint64_t Length;
+    if (!vbr(6, Length) || Length > 8192 || !align32() ||
+        Length > (End - Pos) / 8)
+      return false;
+    Start = reinterpret_cast<const char *>(Data + Pos / 8);
+    Size = size_t(Length);
+    Pos += Length * 8;
+    return align32();
+  }
+};
+
+inline uint64_t offsetAt(const unsigned char *P) noexcept {
+  uint64_t Result = 0;
+  for (unsigned I = 0; I < 8; ++I)
+    Result |= uint64_t(P[I]) << (I * 8);
+  return Result;
+}
+
+inline bool canonicalPath(const char *P, size_t N) noexcept {
+  if (N < 2 || N > 4096 || P[0] != '/' || P[N - 1] == '/')
+    return false;
+  size_t Component = 1;
+  for (size_t I = 1; I <= N; ++I) {
+    if (I < N && (static_cast<unsigned char>(P[I]) < 32 ||
+                  static_cast<unsigned char>(P[I]) == 127 || P[I] == '\\'))
+      return false;
+    if (I == N || P[I] == '/') {
+      size_t Length = I - Component;
+      if (!Length || (Length == 1 && P[Component] == '.') ||
+          (Length == 2 && P[Component] == '.' && P[Component + 1] == '.'))
+        return false;
+      Component = I + 1;
+    }
+  }
+  return true;
+}
+
+inline PCHReceiptProof inspect(const InputLayout &L, void *Context,
+                               PathSink Sink) noexcept {
+  auto Fail = [](const char *Reason) noexcept -> PCHReceiptProof {
+    return {false, false, Reason};
+  };
+  if (!L.Data || !L.Offsets || !Sink || L.Bytes < 4 ||
+      L.Bytes > 256 * 1024 * 1024 || std::memcmp(L.Data, "CPCH", 4) != 0 ||
+      !L.Count || L.Count > 16384 || L.OffsetBytes != L.Count * 8 ||
+      L.BaseBit < 32 || L.BaseBit >= L.EndBit || L.EndBit > L.Bytes * 8 ||
+      L.EndBit % 32 != 0)
+    return Fail("pch-input-layout");
+  // Offset storage must belong to these exact loaded bytes. Integer range
+  // checks avoid undefined subtraction/comparison of unrelated C++ pointers.
+  uintptr_t Begin = reinterpret_cast<uintptr_t>(L.Data);
+  uintptr_t Offsets = reinterpret_cast<uintptr_t>(L.Offsets);
+  if (Offsets < Begin || Offsets - Begin > L.Bytes ||
+      L.OffsetBytes > L.Bytes - (Offsets - Begin))
+    return Fail("pch-input-offsets");
+
+  bool Independent = !L.HasTimestamps;
+  uint64_t Next = L.BaseBit;
+  for (size_t I = 0; I < L.Count; ++I) {
+    uint64_t Offset = offsetAt(L.Offsets + I * 8);
+    if (Offset >= L.EndBit - L.BaseBit || L.BaseBit + Offset != Next)
+      return Fail("pch-input-offsets");
+    CheckedBits Bits(L.Data, Next, L.EndBit);
+    uint64_t Code, ID, Size, Time, Overridden, Transient, TopLevel, ModuleMap;
+    uint64_t RequestedLength;
+    if (!Bits.fixed(4, Code) || Code != 4 || !Bits.vbr(6, ID) || ID != I + 1 ||
+        !Bits.vbr(12, Size) || !Bits.vbr(32, Time) ||
+        !Bits.fixed(1, Overridden) || !Bits.fixed(1, Transient) ||
+        !Bits.fixed(1, TopLevel) || !Bits.fixed(1, ModuleMap) ||
+        !Bits.vbr(16, RequestedLength))
+      return Fail("pch-input-record");
+    if (Overridden || Transient || ModuleMap)
+      return Fail("pch-input-flags");
+    Independent &= Time == 0;
+    const char *Names;
+    size_t NameBytes;
+    if (!Bits.blob(Names, NameBytes) || RequestedLength > NameBytes ||
+        !canonicalPath(Names, size_t(RequestedLength)))
+      return Fail("pch-input-name");
+    size_t ActualLength = NameBytes - size_t(RequestedLength);
+    if (ActualLength &&
+        (ActualLength != RequestedLength ||
+         std::memcmp(Names, Names + RequestedLength, ActualLength) != 0))
+      return Fail("pch-input-alias");
+    uint64_t HashLow, HashHigh;
+    if (!Bits.fixed(4, Code) || Code != 5 || !Bits.fixed(32, HashLow) ||
+        !Bits.fixed(32, HashHigh))
+      return Fail("pch-input-hash");
+    Next = Bits.position();
+    if (!Sink(Context, Names, size_t(RequestedLength)))
+      return Fail("pch-input-capacity");
+  }
+  CheckedBits Tail(L.Data, Next, L.EndBit);
+  uint64_t Code;
+  if (!Tail.fixed(4, Code) || Code != 0 || !Tail.align32() ||
+      Tail.position() != L.EndBit)
+    return Fail("pch-input-block-end");
+  return {true, Independent, nullptr};
+}
+} // namespace pch_detail
+} // namespace clang::webide
+#endif
