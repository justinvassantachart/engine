diff --git a/llvm/include/llvm/Bitstream/BitstreamReader.h b/llvm/include/llvm/Bitstream/BitstreamReader.h
index ff42cda71..160b4b4f8 100644
--- a/llvm/include/llvm/Bitstream/BitstreamReader.h
+++ b/llvm/include/llvm/Bitstream/BitstreamReader.h
@@ -539,6 +539,14 @@ private:
   //===--------------------------------------------------------------------===//
 
 public:
+  /// Read-only bounded observation without allocating an Error on bad input.
+  const BitCodeAbbrev *getAbbrevIfValid(unsigned AbbrevID) const {
+    if (AbbrevID < bitc::FIRST_APPLICATION_ABBREV)
+      return nullptr;
+    unsigned AbbrevNo = AbbrevID - bitc::FIRST_APPLICATION_ABBREV;
+    return AbbrevNo < CurAbbrevs.size() ? CurAbbrevs[AbbrevNo].get() : nullptr;
+  }
+
   /// Return the abbreviation for the specified AbbrevId.
   Expected<const BitCodeAbbrev *> getAbbrev(unsigned AbbrevID) {
     unsigned AbbrevNo = AbbrevID - bitc::FIRST_APPLICATION_ABBREV;
